---
import Base from '../layouts/Base.astro';
import LegalPage from '../components/LegalPage.astro';

const toc = [
  { id: 'short-version', label: 'The short version' },
  { id: 'on-your-mac',   label: 'Everything runs on your Mac' },
  { id: 'cloud-engines', label: 'If you opt into cloud engines' },
  { id: 'website',       label: 'This website' },
  { id: 'contact',       label: 'Questions' },
];

const title = 'Privacy — rekody';
const description = 'rekody is an open-source CLI that runs entirely on your Mac. No accounts, no servers, no telemetry.';
---

<Base title={title} description={description}>
  <LegalPage
    eyebrow="Privacy"
    title="Your voice. Your words. Your machine."
    updated="May 30, 2026"
    summary="rekody is open-source software that runs entirely on your Mac. There are no accounts, no rekody servers, and no telemetry. We can't see your data because it never reaches us."
    toc={toc}
  >
    <section id="short-version">
      <h2>The short version</h2>
      <p>
        rekody is a free, MIT-licensed CLI (<a href="https://github.com/rekody/rekody" target="_blank" rel="noopener noreferrer">github.com/rekody/rekody</a>).
        It has no sign-up, no license server, and no analytics inside the app. Every line of code that touches
        your audio is open for inspection.
      </p>
    </section>

    <section id="on-your-mac">
      <h2>Everything runs on your Mac</h2>
      <p>
        Audio capture, voice detection, transcription, cleanup, and typing the text at your cursor all happen
        on your device. With the default local Whisper engine — or the on-device Apple Intelligence cleanup —
        <strong>nothing leaves your machine at all</strong>.
      </p>
      <ul>
        <li>Your dictation history is a local file: <code>~/.config/rekody/history.json</code>. Delete it whenever you like.</li>
        <li>API keys you add are stored in the macOS Keychain, never in plaintext on disk.</li>
        <li>The only network calls the app makes by itself are checking GitHub for new releases when you run <code>rekody update</code>.</li>
      </ul>
    </section>

    <section id="cloud-engines">
      <h2>If you opt into cloud engines</h2>
      <p>
        You can optionally configure cloud speech-to-text or LLM providers (Deepgram, Groq, OpenAI, Anthropic, and others)
        using <strong>your own API keys</strong>. When you do, your audio or text goes directly from your Mac to that
        provider under their terms — there is no rekody server in the middle, because we don't run any.
        Prefer to stay fully local? Use local Whisper plus Apple's on-device model or Ollama, and nothing is sent anywhere.
      </p>
    </section>

    <section id="website">
      <h2>This website</h2>
      <p>
        rekody.com is a static site. It uses privacy-friendly, cookie-less analytics (Vercel Analytics) for
        anonymous page-view counts. No tracking cookies, no ad pixels, no fingerprinting.
      </p>
    </section>

    <section id="contact">
      <h2>Questions</h2>
      <p>
        Open an issue or discussion on <a href="https://github.com/rekody/rekody" target="_blank" rel="noopener noreferrer">GitHub</a>.
        For security reports, please use a <a href="https://github.com/rekody/rekody/security/advisories/new" target="_blank" rel="noopener noreferrer">private security advisory</a> —
        details in <a href="https://github.com/rekody/rekody/blob/main/SECURITY.md" target="_blank" rel="noopener noreferrer">SECURITY.md</a>.
      </p>
    </section>
  </LegalPage>
</Base>
