---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import OpenSource from '../components/OpenSource.astro';
import Footer from '../components/Footer.astro';

const title = 'Open source — Rekody';
const description = 'The Rekody dictation engine is MIT-licensed on GitHub: six Rust crates and one CLI. The free Mac app is a closed-source shell on the same open engine.';
---

<Base title={title} description={description}>
  <Navbar />
  <main>
    <div style="height:4rem;"></div>
    <OpenSource />
  </main>
  <Footer />
</Base>
