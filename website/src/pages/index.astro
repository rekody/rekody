---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import HeroCinematic from '../components/cinematic/HeroCinematic';
import AboutCinematic from '../components/cinematic/AboutCinematic';
import FeaturesCinematic from '../components/cinematic/FeaturesCinematic';
import { version } from '../lib/version';
---

<Base>
  <main class="bg-black">
    <HeroCinematic client:load version={version} />
    <AboutCinematic client:visible />
    <FeaturesCinematic client:visible />
  </main>
  <Footer />
</Base>
