---
// Stat band — three verified numbers + the scoping caption.
// ~160ms: the streaming engine's chunk length. Felt latency (half a chunk of
//   algorithmic wait plus measured compute for that chunk) is 127.8ms p50 on
//   the 160ms profile; quoted conservatively at the chunk length itself.
//   Replaces an earlier "~100ms key release -> final text", which was derived
//   from the old ~55ms pad-to-one-chunk flush. That flush is now a fixed 560ms
//   of trailing silence (~170-210ms) because the short one was dropping final
//   words, so the old number is no longer true and the release edge is no
//   longer the flattering way to describe this engine. What improved is that
//   text now lands while you are still talking.
// 0 network calls: runtime dictation path; models download once at setup.
// ~35 MB: actual release binary size (unstripped), vs ~250 MB Electron apps.
const stats = [
  { value: '~160ms', label: 'Words appear while you talk', teal: false },
  { value: '0',      label: 'Network calls while dictating', teal: true },
  { value: '~35 MB', label: 'One native binary, not Electron', teal: false },
];
---

<section aria-label="Rekody by the numbers" style="background:var(--color-cream-warm); border-top:1px solid var(--color-hairline); border-bottom:1px solid var(--color-hairline);">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 sm:grid-cols-3">
      {stats.map((s, i) => (
        <div class={`flex flex-col items-center gap-2 py-10 sm:py-11 px-6 ${i > 0 ? 'border-t sm:border-t-0 sm:border-l' : ''}`} style="border-color:var(--color-hairline);">
          <span class="display" style={`font-size:clamp(34px,3.5vw,44px); ${s.teal ? 'color:var(--color-teal);' : ''}`}>{s.value}</span>
          <span class="font-mono text-[11px] sm:text-[12px] uppercase text-center" style="color:var(--color-ink-faint); letter-spacing:0.1em;">{s.label}</span>
        </div>
      ))}
    </div>
    <p class="font-mono text-[11px] text-center pb-6" style="color:var(--color-ink-faint);">
      Measured on the default on-device engine. Speech models download once at setup; dictation itself never touches the network.
    </p>
  </div>
</section>
