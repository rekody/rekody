---
// Hero — "You talk. It types." + the live HUD pill (hands-free state),
// mirroring the native PillView.swift anatomy: target-app icon, hollow teal
// circle + teal timer, stop hint, amplitude-ramped waveform, dim→bright
// transcript tail, blinking caret.

// Waveform bars: [height(px), amplitude-ramp color] — quiet→loud teal ramp.
const bars: [number, string][] = [
  [4, '#20808D'], [7, '#2FA3B3'], [12, '#2FA3B3'], [18, '#7FD4DE'],
  [22, '#7FD4DE'], [16, '#4FB8C5'], [10, '#2FA3B3'], [14, '#4FB8C5'],
  [20, '#7FD4DE'], [17, '#4FB8C5'], [9, '#2FA3B3'], [13, '#4FB8C5'],
  [6, '#20808D'], [11, '#2FA3B3'], [5, '#20808D'],
];

// "lands at your cursor in" — typing-heavy apps (marks from Simple Icons, MIT).
const apps = [
  { name: 'Gmail', fg: '#EA4335', d: 'M24 5.457v13.909c0 .904-.732 1.636-1.636 1.636h-3.819V11.73L12 16.64l-6.545-4.91v9.273H1.636A1.636 1.636 0 0 1 0 19.366V5.457c0-2.023 2.309-3.178 3.927-1.964L5.455 4.64 12 9.548l6.545-4.91 1.528-1.145C21.69 2.28 24 3.434 24 5.457z' },
  { name: 'Google Docs', fg: '#4285F4', d: 'M14.727 6.727H14V0H4.91c-.905 0-1.637.732-1.637 1.636v20.728c0 .904.732 1.636 1.636 1.636h14.182c.904 0 1.636-.732 1.636-1.636V6.727h-6zm-.545 10.455H7.091v-1.364h7.09v1.364zm2.727-3.273H7.091v-1.364h9.818v1.364zm0-3.273H7.091V9.273h9.818v1.363zM14.727 6h6l-6-6v6z' },
  { name: 'LinkedIn', fg: '#0A66C2', d: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z' },
  { name: 'Linear', fg: '#5E6AD2', d: 'M2.886 4.18A11.982 11.982 0 0 1 11.99 0C18.624 0 24 5.376 24 12.009c0 3.64-1.62 6.903-4.18 9.105L2.887 4.18ZM1.817 5.626l16.556 16.556c-.524.33-1.075.62-1.65.866L.951 7.277c.247-.575.537-1.126.866-1.65ZM.322 9.163l14.515 14.515c-.71.172-1.443.282-2.195.322L0 11.358a12 12 0 0 1 .322-2.195Zm-.17 4.862 9.823 9.824a12.02 12.02 0 0 1-9.824-9.824Z' },
];

// Notion mark for the pill's target-app badge (Simple Icons, MIT).
const notionD = 'M4.459 4.208c.746.606 1.026.56 2.428.466l13.215-.793c.28 0 .047-.28-.046-.326L17.86 1.968c-.42-.326-.981-.7-2.055-.607L3.01 2.295c-.466.046-.56.28-.374.466zm.793 3.08v13.904c0 .747.373 1.027 1.214.98l14.523-.84c.841-.046.935-.56.935-1.167V6.354c0-.606-.233-.933-.748-.887l-15.177.887c-.56.047-.747.327-.747.933zm14.337.745c.093.42 0 .84-.42.888l-.7.14v10.264c-.608.327-1.168.514-1.635.514-.748 0-.935-.234-1.495-.933l-4.577-7.186v6.952L12.21 19s0 .84-1.168.84l-3.222.186c-.093-.186 0-.653.327-.746l.84-.233V9.854L7.822 9.76c-.094-.42.14-1.026.793-1.073l3.456-.233 4.764 7.279v-6.44l-1.215-.139c-.093-.514.28-.887.747-.933zM1.936 1.035l13.31-.98c1.634-.14 2.055-.047 3.082.7l4.249 2.986c.7.513.934.653.934 1.213v16.378c0 1.026-.373 1.634-1.68 1.726l-15.458.934c-.98.047-1.448-.093-1.962-.747l-3.129-4.06c-.56-.747-.793-1.306-.793-1.96V2.667c0-.839.374-1.54 1.447-1.632z';
---

<section id="hero" class="pt-16" style="background:#FFFFFF;">
  <div class="max-w-6xl mx-auto px-6 pt-20 md:pt-24 pb-16 md:pb-20 flex flex-col items-center text-center gap-7">

    <!-- Eyebrow -->
    <p class="flex items-center gap-2.5 font-mono text-[12px] uppercase" style="color:var(--color-ink-faint); letter-spacing:0.16em;">
      <span class="inline-block w-[7px] h-[7px] rounded-full" style="background:var(--color-teal);" aria-hidden="true"></span>
      Free &middot; Open source &middot; macOS
    </p>

    <!-- Headline -->
    <h1 class="display" style="font-size:clamp(44px,8.5vw,104px);">
      You talk. <span class="display-italic block sm:inline" style="color:var(--color-teal);">It types.</span>
    </h1>

    <!-- Subhead -->
    <p class="max-w-[640px] text-[17px] md:text-[19px]" style="color:var(--color-ink-mute); line-height:1.6;">
      Free, open-source dictation for your Mac. Hold <span class="key">⌥</span> <span class="key">Space</span> and speak.
      Let go, and the text lands at your cursor in any app. It all runs on your machine.
    </p>

    <!-- CTAs -->
    <div class="flex w-full max-w-[400px] sm:max-w-none sm:w-auto flex-col sm:flex-row items-stretch sm:items-center justify-center gap-4 pt-1">
      <a href="https://github.com/rekody/rekody-app/releases/latest/download/Rekody.dmg" class="pill pill-dark justify-center" style="padding:0.9rem 1.9rem; font-size:16px; gap:0.6rem;">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.702"/></svg>
        Download for Mac — free
      </a>
      <button id="hero-brew-copy" class="pill pill-ghost font-mono justify-center" style="padding:0.85rem 1.5rem; font-size:13px;" data-cmd="brew install rekody/rekody/rekody">
        <span aria-hidden="true" style="color:var(--color-teal);">$</span><span id="hero-brew-label">brew install rekody/rekody/rekody</span>
      </button>
    </div>

    <!-- Trust line -->
    <p class="font-mono text-[12px]" style="color:var(--color-ink-faint);">
      macOS 13+ &middot; Apple Silicon (Intel via the CLI) &middot; no account &middot; no telemetry
    </p>

    <!-- Live HUD pill -->
    <div id="demo" class="flex flex-col items-center gap-6 pt-4 w-full">
      <div
        class="hud-live flex w-full max-w-[420px] md:w-auto md:max-w-full flex-col md:flex-row md:items-center gap-3 md:gap-4 rounded-[22px] md:rounded-full px-5 py-3.5 md:py-[11px] overflow-hidden"
        style="background:#0D1414; border:1px solid rgba(47,163,179,0.4); box-shadow:0 30px 80px -30px rgba(15,23,23,0.35);"
        role="img"
        aria-label="The Rekody pill recording hands-free: timer, live waveform, and words appearing as you speak"
      >
        <!-- Row 1 on mobile (badge + state + waveform); flattens into the single pill row on md+ -->
        <span class="flex items-center justify-between gap-3 md:contents">
          <span class="flex items-center gap-3 md:gap-4 md:contents">
            <!-- Target app badge -->
            <span class="flex items-center justify-center w-5 h-5 rounded-[5px] shrink-0" style="background:#FFFFFF;">
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="#111111" aria-hidden="true"><path d={notionD} /></svg>
            </span>
            <!-- State: hollow circle + teal timer + stop hint -->
            <span class="flex items-center gap-1.5 shrink-0">
              <span class="inline-block w-[9px] h-[9px] rounded-full" style="border:1.5px solid #2FA3B3;" aria-hidden="true"></span>
              <span id="hud-timer" class="font-mono font-bold text-[13px]" style="color:#2FA3B3;">0:07</span>
              <span class="hud-stop-hint text-[11px] font-medium pl-1 whitespace-nowrap" style="color:rgba(251,250,244,0.55);">tap ⌥ + space to stop</span>
            </span>
          </span>
          <!-- Waveform -->
          <span class="flex items-center gap-[2px] shrink-0" aria-hidden="true">
            {bars.map(([h, c]) => (
              <span class="hud-bar" style={`height:${h}px; background:${c};`}></span>
            ))}
          </span>
        </span>
        <!-- Row 2 on mobile (live transcript tail + caret, under a hairline); inline on md+ -->
        <span class="flex items-center gap-[5px] min-w-0 pt-2.5 md:contents" style="border-top:1px solid rgba(251,250,244,0.12);">
          <span class="text-[12px] whitespace-nowrap truncate">
            <span style="color:#5E6E6E;">…and the words land </span><span style="color:#FBFAF4;">as I say them</span>
          </span>
          <span class="hud-caret inline-block w-[7px] h-[15px] rounded-[3px] shrink-0" style="background:#7FD4DE;" aria-hidden="true"></span>
        </span>
      </div>

      <!-- Landing strip -->
      <div class="flex flex-col sm:flex-row sm:flex-wrap items-center justify-center gap-2.5 sm:gap-3">
        <span class="flex items-center gap-2.5 sm:gap-3 sm:contents">
          <span class="font-mono text-[12px]" style="color:var(--color-ink-faint);">lands at your cursor in</span>
          {apps.map(a => (
            <span class="app-ios-tile flex items-center justify-center w-[30px] h-[30px] rounded-lg" style="background:#FFFFFF; border:1px solid rgba(15,23,23,0.1);" title={a.name}>
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill={a.fg} aria-label={a.name}><path d={a.d} /></svg>
            </span>
          ))}
        </span>
        <span class="flex items-center gap-2.5 sm:gap-3 sm:contents">
          <span class="font-mono text-[12px]" style="color:var(--color-ink-faint);">…or anywhere else you type</span>
          <span class="font-mono text-[12px]" style="color:var(--color-teal);">~100ms</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* Stop hint: hidden only on the very narrowest phones (<380px) where pill row 1 runs out of room. */
  .hud-stop-hint { display: none; }
  @media (min-width: 380px) { .hud-stop-hint { display: inline; } }
</style>

<script>
  // Copy the brew command; brief confirmation swap.
  const btn = document.getElementById('hero-brew-copy') as HTMLButtonElement | null;
  const label = document.getElementById('hero-brew-label');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn?.dataset.cmd ?? 'brew install rekody/rekody/rekody');
      if (label) {
        const prev = label.textContent;
        label.textContent = '✓ copied';
        setTimeout(() => { if (label) label.textContent = prev; }, 1400);
      }
    } catch { /* clipboard unavailable — leave the command visible to select */ }
  });

  // Tick the pill timer like a real recording (paused under reduced motion).
  const timer = document.getElementById('hud-timer');
  if (timer && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let s = 7;
    setInterval(() => {
      s = (s + 1) % 3600;
      const m = Math.floor(s / 60);
      timer.textContent = `${m}:${String(s % 60).padStart(2, '0')}`;
    }, 1000);
  }
</script>
