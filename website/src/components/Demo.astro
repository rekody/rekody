---
const steps = [
  {
    num: '01',
    title: 'Hold',
    body: 'Hold <span class="key">⌥</span> + <span class="key">Space</span> anywhere on macOS. A quiet indicator shows the mic is live.',
  },
  {
    num: '02',
    title: 'Speak',
    body: 'Speak naturally. With the Whisper engine, rekody handles 100+ languages — the default on-device engine is English-only for now.',
  },
  {
    num: '03',
    title: 'Release',
    body: 'Let go. Text lands at your cursor — engine of your choice, no paste step.',
  },
];
---

<section id="how-it-works" class="relative max-w-6xl mx-auto px-6 py-20">
  <!-- Section heading -->
  <div class="mb-16 max-w-2xl">
    <p class="text-[11px] font-mono uppercase mb-4" style="color:var(--color-ink-faint); letter-spacing:0.12em;">How it works</p>
    <h2 class="display" style="font-size:clamp(36px, 5vw, 56px);">
      Three beats: hold, speak, <span class="display-italic" style="color:var(--color-teal);">release</span>.
    </h2>
    <p class="body-serif mt-5" style="font-size:18px;">
      Push to talk, release to send — native to macOS, final text ~100ms after you let go.
    </p>
  </div>

  <!-- Steps grid -->
  <div class="grid md:grid-cols-3 gap-px rounded-2xl overflow-hidden" style="background:var(--color-hairline); border:1px solid var(--color-hairline);">
    {steps.map(s => (
      <article class="p-8 flex flex-col gap-5" style="background:var(--color-cream);">
        <div class="flex items-center justify-between">
          <span class="text-[11px] font-mono" style="color:var(--color-ink-faint); letter-spacing:0.08em;">{s.num}</span>
          <span class="display-italic" style="font-size:28px; color:var(--color-teal);">·</span>
        </div>
        <h3 class="display" style="font-size:40px;">{s.title}</h3>
        <p class="body-serif" style="font-size:16px;" set:html={s.body}></p>
      </article>
    ))}
  </div>

  <!-- See it work — real screen recording goes here -->
  <div class="mt-16">
    <div class="flex items-baseline justify-between gap-4 flex-wrap mb-5">
      <h3 class="display" style="font-size:clamp(22px, 2.8vw, 30px);">See it work.</h3>
      <span class="text-[11px] font-mono uppercase" style="color:var(--color-ink-faint); letter-spacing:0.12em;">hold · speak · release</span>
    </div>

    <!--
      VIDEO SLOT: drop the exported recording in here when ready.
      Replace this <div class="demo-video-placeholder"> with:
        <video class="w-full h-full object-cover" muted playsinline preload="metadata"
               poster="/demo-poster.jpg" controls>
          <source src="/demo.webm" type="video/webm" />
          <source src="/demo.mp4" type="video/mp4" />
        </video>
      Keep the outer aspect-ratio wrapper below so layout doesn't shift.
    -->
    <div class="relative rounded-3xl overflow-hidden" style="aspect-ratio:16/9; background:var(--color-ink); border:1px solid rgba(251,250,244,0.08); box-shadow:0 30px 80px -40px rgba(15,23,23,0.4);">
      <div class="demo-video-placeholder absolute inset-0 flex flex-col items-center justify-center gap-4" aria-hidden="true">
        <!-- play glyph -->
        <div class="flex items-center justify-center w-16 h-16 rounded-full" style="background:rgba(32,128,141,0.18); border:1px solid rgba(32,128,141,0.4);">
          <svg class="w-6 h-6 ml-0.5" viewBox="0 0 24 24" fill="var(--color-teal)" aria-hidden="true">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
        <p class="font-mono text-[12px] uppercase" style="color:rgba(251,250,244,0.45); letter-spacing:0.14em;">Recording coming soon</p>
      </div>
    </div>
  </div>
</section>
