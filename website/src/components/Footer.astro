---
import { version } from '../lib/version';

const cols = [
  {
    title: 'Product',
    links: [
      { label: 'How it works',      href: '/#how-it-works' },
      { label: 'Use cases',         href: '/use-cases' },
      { label: 'Download for Mac',  href: 'https://github.com/rekody/rekody-app/releases/latest/download/Rekody.dmg' },
      { label: 'CLI',               href: '/cli' },
      { label: 'Docs',              href: 'https://docs.rekody.com', external: true },
    ],
  },
  {
    title: 'Open source',
    links: [
      { label: 'GitHub',       href: 'https://github.com/rekody/rekody', external: true },
      { label: 'Issues',       href: 'https://github.com/rekody/rekody/issues', external: true },
      { label: 'Discussions',  href: 'https://github.com/rekody/rekody/discussions', external: true },
      { label: 'Contributing', href: 'https://github.com/rekody/rekody/blob/main/CONTRIBUTING.md', external: true },
      { label: 'Changelog',    href: 'https://github.com/rekody/rekody/blob/main/CHANGELOG.md', external: true },
    ],
  },
  {
    title: 'Support & legal',
    links: [
      { label: 'Support',     href: '/support' },
      { label: 'Privacy',     href: '/privacy' },
      { label: 'Security',    href: 'https://github.com/rekody/rekody/blob/main/SECURITY.md', external: true },
      { label: 'EULA',        href: 'https://github.com/rekody/rekody-app/blob/main/EULA.md', external: true },
      { label: 'MIT License', href: 'https://github.com/rekody/rekody/blob/main/LICENSE', external: true },
    ],
  },
];

const social = [
  { label: 'GitHub',       href: 'https://github.com/rekody',                logo: '/logos/github.svg' },
  { label: 'LinkedIn',     href: 'https://www.linkedin.com/company/rekody/', logo: '/logos/linkedin.svg' },
  { label: 'Hugging Face', href: 'https://huggingface.co/Rekody',            logo: '/logos/huggingface.svg' },
];
---

<footer class="relative" style="background:var(--color-cream-warm); border-top:1px solid var(--color-hairline);">
  <div class="max-w-6xl mx-auto px-6 py-16">

    <div class="grid grid-cols-2 gap-x-8 gap-y-10 md:gap-x-16 md:grid-cols-[1.4fr_1fr_1fr_1fr]">

      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-2.5 mb-4">
          <span style="font-family:var(--font-serif); font-size:20px; color:var(--color-ink);">rekody<span style="color:var(--color-teal);">.</span></span>
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded" style="background:var(--color-teal-soft); color:var(--color-teal); letter-spacing:0.02em;">v{version}</span>
        </div>
        <p class="body-serif max-w-sm" style="font-size:14px;">
          Free, open-source voice dictation for macOS. Hold <span class="key">⌥</span> + <span class="key">Space</span> anywhere; text lands at your cursor in any app. On-device by default.
        </p>
        <div class="flex items-center gap-4 mt-5">
          {social.map(s => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon"
              aria-label={s.label}
              title={s.label}
            >
              <img src={s.logo} alt={s.label} class="w-5 h-5" loading="lazy" />
            </a>
          ))}
        </div>
      </div>

      {cols.map(c => (
        <div>
          <h4 class="text-[11px] font-mono uppercase mb-4" style="color:var(--color-ink-faint); letter-spacing:0.12em;">{c.title}</h4>
          <ul class="flex flex-col gap-2.5">
            {c.links.map(l => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noopener noreferrer' : undefined}
                  class="text-[14px] transition-colors"
                  style="color:var(--color-ink-soft);"
                >{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="hairline my-10"></div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 justify-between text-[13px]" style="color:var(--color-ink-mute);">
      <p>
        <span title="From Swahili 'rekodi', to record">rekody /rɛˈkoʊ.di/</span>
      </p>
      <p class="font-mono text-[12px]" style="color:var(--color-ink-faint);">© 2026 · MIT License</p>
    </div>
  </div>
</footer>

<style>
  footer a:hover { color: var(--color-ink); }
</style>
