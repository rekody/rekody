---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  faqSchema?: { q: string; a: string }[];
}

const {
  title = 'Rekody — You talk. It types.',
  description = 'Free, open-source voice dictation for macOS. Hold ⌥ Space and speak; the text lands at your cursor in any app about 100ms after you release. On-device by default — no account, no analytics, no audio stored.',
  ogImage = '/og.png',
  faqSchema,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://rekody.com');
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://rekody.com');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Tony Kipkemboi" />
    <meta name="theme-color" content="#FFFFFF" />

    <!-- Robots -->
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rekody" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content="Rekody. You talk. It types." />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@tonykipkemboi" />
    <meta name="twitter:creator" content="@tonykipkemboi" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Rekody. You talk. It types." />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=4" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=4" />
    <link rel="icon" type="image/png" href="/icon.png?v=4" sizes="1024x1024" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />

    <!-- JSON-LD: Organization + WebSite + SoftwareApplication. The app is
         free but not MIT (the EULA covers it; only the CLI is MIT), so the
         schema carries no license claim. -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://rekody.com/#org",
          "name": "Rekody",
          "url": "https://rekody.com/",
          "logo": "https://rekody.com/icon.png",
          "email": "hi@rekody.com",
          "sameAs": [
            "https://github.com/rekody",
            "https://huggingface.co/Rekody",
            "https://www.linkedin.com/company/rekody/",
          ],
        },
        {
          "@type": "WebSite",
          "@id": "https://rekody.com/#website",
          "url": "https://rekody.com/",
          "name": "Rekody",
          "publisher": { "@id": "https://rekody.com/#org" },
        },
        {
          "@type": "SoftwareApplication",
          "name": "Rekody",
          "applicationCategory": "UtilitiesApplication",
          "operatingSystem": "macOS 13.0 or later",
          "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
          "url": "https://rekody.com/",
          "downloadUrl": "https://github.com/rekody/rekody-app/releases/latest/download/Rekody.dmg",
          "description": description,
          "publisher": { "@id": "https://rekody.com/#org" },
          "author": {
            "@type": "Person",
            "name": "Tony Kipkemboi",
            "url": "https://github.com/tonykipkemboi",
          },
        },
      ],
    })} />

    <!-- JSON-LD: FAQPage -->
    {faqSchema && faqSchema.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faqSchema.map(({ q, a }) => ({
          "@type": "Question",
          "name": q,
          "acceptedAnswer": { "@type": "Answer", "text": a },
        })),
      })} />
    )}
  </head>
  <body>
    <slot />
    <Analytics />

    <!-- Scroll-reveal: below-fold sections fade up once on enter. JS-driven
         (no-JS sees everything), reduced-motion disabled, one-shot. -->
    <script is:inline>
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { e.target.classList.add('reveal-in'); io.unobserve(e.target); }
          }
        }, { threshold: 0.1, rootMargin: '0px 0px -8% 0px' });
        const fold = window.innerHeight * 0.88;
        document.querySelectorAll('section').forEach((el) => {
          if (el.getBoundingClientRect().top < fold) return; // already visible — never hide
          el.classList.add('reveal-init');
          io.observe(el);
        });
      })();
    </script>
    <style is:global>
      .reveal-init { opacity: 0; transform: translateY(22px); will-change: opacity, transform; }
      .reveal-in { opacity: 1; transform: none; transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1); }
      @media (prefers-reduced-motion: reduce) {
        .reveal-init, .reveal-in { opacity: 1; transform: none; transition: none; }
      }
    </style>
  </body>
</html>
